{
  "$schema": "https://json.schemastore.org/claude-settings.json",
  "project_name": "nb_fairyfly",
  "canonical_title": "Neutron Binary Percipience - Enterprise Context Engineering OS & Autonomous CI/CD Gatekeeper",
  "version": "7.5.0",
  "architecture": "Quad-Space Context Engineering (.nb / workplace / user / .claude)",
  "settings_file": ".nb/config/claude_agents_settings.yaml",
  "model_tiering_policy": {
    "provider_agnostic": true,
    "default_model": "claude-3-5-sonnet-20241022",
    "tier_a_frontier": "claude-3-7-sonnet",
    "tier_b_production": "claude-3-5-sonnet-20241022",
    "tier_c_high_throughput": "claude-3-5-haiku-20241022",
    "reference_models": {
      "tier_a": [
        "claude-3-7-sonnet",
        "gemini-2.0-pro",
        "gpt-4o",
        "deepseek-r1"
      ],
      "tier_b": [
        "claude-3-5-haiku",
        "gemini-2.0-flash",
        "gpt-4o-mini"
      ]
    }
  },
  "runtime_environment": {
    "PYTHONPATH": ".:.nb:.nb/core:workplace:workplace/core",
    "PERCIPIENCE_CLI": ".nb/bin/percipience",
    "PERCIPIENCE_TERMINAL_MODE": "1",
    "PERCIPIENCE_AST_COMPRESSION": "1"
  },
  "context_rules": {
    "merkle_ledger": ".nb/context/ledger/context_ledger.yaml",
    "banking_security": ".nb/context/rules/banking_security.md",
    "capability_tokens": ".nb/context/rules/capability_tokens.yaml",
    "commercial_tier_permissioning_rules": ".nb/context/rules/commercial_tier_permissioning_rules.md",
    "jcef_security": ".nb/context/rules/jcef_security_invariants.md",
    "jetbrains_threading": ".nb/context/rules/jetbrains_platform_threading_rules.md",
    "multitenant_isolation_rules": ".nb/context/rules/multitenant_isolation_rules.md",
    "pii_protection_rules": ".nb/context/rules/pii_protection_rules.md",
    "psi_read_lock": ".nb/context/rules/psi_read_lock_invariants.md",
    "rbac_governance_rules": ".nb/context/rules/rbac_governance_rules.md",
    "realtime_rendering_rules": ".nb/context/rules/realtime_rendering_rules.md",
    "secret_storage": ".nb/context/rules/secret_storage_rules.md",
    "ui_token_consistency_rules": ".nb/context/rules/ui_token_consistency_rules.md",
    "vscode_activation_invariants": ".nb/context/rules/vscode_activation_invariants.md",
    "webview_security_invariants": ".nb/context/rules/webview_security_invariants.md",
    "zero_trust_rules": ".nb/context/rules/zero_trust_rules.md"
  },
  "context_contracts": {
    "billing_meter_contract": ".nb/context/contracts/billing_meter_contract.yaml",
    "billing_webhook_contract": ".nb/context/contracts/billing_webhook_contract.json",
    "ble_gatt_spec": ".nb/context/contracts/ble_gatt_spec.yaml",
    "commercial_provisioning": ".nb/context/contracts/commercial_provisioning_contract.yaml",
    "daemon_rpc": ".nb/context/contracts/daemon_rpc_contract.json",
    "data_grid_contract": ".nb/context/contracts/data_grid_contract.json",
    "hierarchical_rule_contract": ".nb/context/contracts/hierarchical_rule_contract.json",
    "intellij_manifest": ".nb/context/contracts/intellij_plugin_manifest_contract.json",
    "lsp_protocol_contract": ".nb/context/contracts/lsp_protocol_contract.yaml",
    "mtls_provisioning_contract": ".nb/context/contracts/mtls_provisioning_contract.json",
    "observability_contract": ".nb/context/contracts/observability_contract.yaml",
    "onboarding_contract": ".nb/context/contracts/onboarding_contract.yaml",
    "ota_firmware_manifest": ".nb/context/contracts/ota_firmware_manifest.json",
    "package_json_manifest_contract": ".nb/context/contracts/package_json_manifest_contract.json",
    "portal_openapi_spec": ".nb/context/contracts/portal_openapi_spec.yaml",
    "psi_ast_bridge": ".nb/context/contracts/psi_ast_bridge_contract.yaml",
    "rbac_permission_matrix": ".nb/context/contracts/rbac_permission_matrix.json",
    "sandbox_permission_contract": ".nb/context/contracts/sandbox_permission_contract.json",
    "security_four_eyes_contract": ".nb/context/contracts/security_four_eyes_contract.json",
    "security_mfa_challenge_contract": ".nb/context/contracts/security_mfa_challenge_contract.json",
    "security_pii_vault_contract": ".nb/context/contracts/security_pii_vault_contract.json",
    "security_rebac_policy_contract": ".nb/context/contracts/security_rebac_policy_contract.json",
    "security_tenant_profile_contract": ".nb/context/contracts/security_tenant_profile_contract.json",
    "terminal_agent_ast": ".nb/context/contracts/terminal_agent_ast_contract.yaml",
    "ui_theme_token_contract": ".nb/context/contracts/ui_theme_token_contract.json",
    "webview_message_rpc_contract": ".nb/context/contracts/webview_message_rpc_contract.json"
  },
  "ignore_patterns": [
    ".git/**",
    ".workspaces/**",
    ".nb/workspaces/**",
    "__pycache__/**",
    "**/*.pyc",
    "build/**",
    ".gradle/**",
    "node_modules/**"
  ],
  "agent_registry": [
    "agent_adversarial_fuzzer",
    "agent_ambiguity_resolver",
    "agent_cloud_security_officer",
    "agent_commercial_packager_provisioner",
    "agent_consolidation_synthesizer",
    "agent_contract_compatibility_checker",
    "agent_dependency_cve_sentinel",
    "agent_doc_drift_synchronizer",
    "agent_enterprise_saas_portal_architect",
    "agent_flaky_test_detector",
    "agent_intellij_ui_ux_engineer",
    "agent_iot_mobile_ecosystem_architect",
    "agent_jetbrains_plugin_architect",
    "agent_living_doc_architect",
    "agent_lsp_language_features_specialist",
    "agent_mobile_developer",
    "agent_portal_developer",
    "agent_privacy_compliance_auditor",
    "agent_psi_ast_bridge_specialist",
    "agent_quality_guard",
    "agent_registry_synchronizer",
    "agent_request_formalizer",
    "agent_saas_backend_developer",
    "agent_security_auditor",
    "agent_terminal_mode_specialist",
    "agent_test_finops_auditor",
    "agent_token_finops_auditor",
    "agent_ui_component_engineer",
    "agent_ui_design_system_architect",
    "agent_vscode_extension_architect",
    "agent_vscode_webview_ux_engineer"
  ]
}
