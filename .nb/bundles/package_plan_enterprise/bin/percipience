def cmd_formalize(args):
    _require_engine(RequestFormalizerEngine, "request_formalizer", "formalize", "Free / Team / Business / Enterprise")
    print(f"📝 Formalizing unstructured engineering request...")
    print(f"   Input: {args.input}")
    print(f"   Target Format: {args.format}")
    out_dir = Path(args.out_dir) if args.out_dir else None

    try:
        res = RequestFormalizerEngine.formalize(
            input_data=args.input,
            target_format=args.format,
            out_dir=out_dir,
            workspace_root=REPO_ROOT
        )
        print(f"✅ Request formalized successfully!")
        print(f"   Request ID: {res['request_id']}")
        print(f"   Title: {res['title']}")
        print(f"   Format Type: {res['format_type']}")
        print(f"   Target Module: {res['target_module']}")
        print(f"   Captured At: {res['relative_file_path']}")
        print(f"   SHA-256: {res['content_sha256'][:16]}...")

        if args.run_workflow:
            print(f"🚀 Running formalized request through derivation workflow: {args.workflow}...")
            wf_res = RequestFormalizerEngine.run_through_workflow(
                formal_file_path=res['formal_file_path'],
                workflow_name=args.workflow,
                workspace_root=REPO_ROOT
            )
            print(f"✅ Derivation workflow execution completed!")
            print(f"   Workflow: {wf_res['workflow']}")
            print(f"   Merkle Block Sealed: {wf_res['merkle_block_id']} ({wf_res['merkle_block_hash'][:16]}...)")
            print(f"   Ledger Updated: context/ledger/context_ledger.yaml")
    except Exception as e:
        print(f"❌ Formalization failed: {e}")
        sys.exit(1)

def cmd_guardrail(args):
    action = args.guardrail_action
    if action == "pii":
        _require_engine(PIISanitizer, "pii_sanitizer", "guardrail pii", "Business / Enterprise")
        sanitizer = PIISanitizer.get_instance()
        text = args.text or ""
        if args.file:
            p = Path(args.file)
            if not p.is_absolute():
                p = REPO_ROOT / p
            if p.exists():
                text = p.read_text(encoding="utf-8")
        session_id = args.session or "cli_session"
        if args.deanonymize:
            res_text = sanitizer.deanonymize(text, session_id=session_id)
            print("🔓 De-anonymized Text:")
            print(res_text)
        else:
            res = sanitizer.anonymize(text, session_id=session_id)
            print("🛡️  PII Masking Results (Lakera / Presidio Parity):")
            print(f"   Session ID: {res['session_id']}")
            print(f"   Tokens Masked: {res['tokens_masked']}")
            print(f"   Entities Detected: {json.dumps(res['entities_detected'])}")
            print(f"   Duration: {res['duration_ms']} ms")
            print(f"   Memory-Only Vault Active: {res['memory_only']}")
            print("   --- Masked Payload ---")
            print(res["sanitized_text"])

    elif action == "injection":
        _require_engine(PromptInjectionGuard, "prompt_injection_guard", "guardrail injection", "Business / Enterprise")
        guard = PromptInjectionGuard()
        payload = args.text or ""
        if args.file:
            p = Path(args.file)
            if not p.is_absolute():
                p = REPO_ROOT / p
            if p.exists():
                payload = p.read_text(encoding="utf-8")
        res = guard.scan_payload(payload, source=args.source or "cli_input", strict=args.strict)
        icon = "✅" if res["verdict"] == "ALLOWED" else ("⚠️" if res["verdict"] == "QUARANTINED" else "🛑")
        print(f"{icon} Prompt Injection Firewall Scan (Prompt Armor / Lakera Parity):")
        print(f"   Verdict: {res['verdict']}")
        print(f"   Risk Score: {res['risk_score']:.3f}")
        print(f"   Is Safe: {res['is_safe']}")
        print(f"   Violations Found: {res['violations_count']}")
        for v in res["violations"]:
            print(f"   - [{v['category']}] ({v['severity']}): {v['description']} -> '{v['snippet']}'")
        if not res["is_safe"]:
            print("   --- Neutralized Payload ---")
            print(res["neutralized_payload"])

    elif action == "output-check":
        _require_engine(OutputGuardrailValidator, "output_guardrail_validator", "guardrail output-check", "Business / Enterprise")
        validator = OutputGuardrailValidator(REPO_ROOT)
        code = args.code or ""
        file_path = args.file
        if file_path:
            p = Path(file_path)
            if not p.is_absolute():
                p = REPO_ROOT / p
            if p.exists():
                code = p.read_text(encoding="utf-8")
        lang = args.lang or "python"
        res = validator.validate_code_output(code, language=lang, file_path=file_path)
        icon = "✅" if res["is_valid"] else "❌"
        print(f"{icon} Post-Generation Output Guardrail Validation (NeMo / Guardrails AI Parity):")
        print(f"   Valid: {res['is_valid']}")
        print(f"   Syntax Clean: {res['is_syntax_valid']}")
        print(f"   Action: {res['action']}")
        print(f"   Safety Score: {res['safety_score']:.2f}")
        print(f"   Violations Count: {res['violations_count']}")
        for v in res["violations"]:
            print(f"   - [{v.get('type')}] ({v.get('severity')}): {v.get('description')} (target: {v.get('target', 'N/A')})")
        if res["remediation_prompt"]:
            print("   --- Remediation Prompt ---")
            print(res["remediation_prompt"])


def cmd_sandbox(args):
    _require_engine(MicroVMSandbox, "microvm_sandbox", "sandbox", "Free / Team / Business / Enterprise")
    action = args.sandbox_action
    mgr = MicroVMSandbox(workspace_root=REPO_ROOT)
    if action == "exec":
        from core.microvm_sandbox import SandboxConfig
        cfg = SandboxConfig(
            runtime=getattr(args, "runtime", "auto"),
            memory_limit_mb=getattr(args, "memory", 512),
            timeout_seconds=getattr(args, "timeout", 30)
        )
        res = mgr.run_sandboxed(cmd=args.cmd, config=cfg)
        print(f"⚡ MicroVM Sandbox Execution Completed [{res.runtime_used}]:")
        print(f"   Exit Code: {res.exit_code} | Boot Latency: {res.boot_latency_ms}ms | Wall Time: {res.duration_ms}ms")
        print(f"   Memory Peak: {res.memory_peak_mb}MB | Sandboxed: {res.sandboxed}")
        if res.stdout.strip():
            out_str = res.stdout.strip()
            print(f"   Output: {out_str}")
        if res.stderr.strip():
            err_str = res.stderr.strip()
            print(f"   Stderr: {err_str}")
        if res.security_violations:
            print(f"   ⚠️ Security Violations: {', '.join(res.security_violations)}")
        sys.exit(res.exit_code)
    elif action == "list":
        boxes = mgr.list_sandboxes()
        print(f"📋 Active Ephemeral Sandboxes ({len(boxes)} active):")
        for b in boxes:
            print(f"   • {b['sandbox_id']}: runtime={b['runtime']} boot={b['boot_latency_ms']}ms mem={b['memory_limit_mb']}MB")

def cmd_oidc(args):
    _require_engine(OIDCAuthenticator, "oidc_authenticator", "oidc", "Free / Team / Business / Enterprise")
    action = args.oidc_action
    auth = OIDCAuthenticator(workspace_root=REPO_ROOT)
    if action == "token":
        tok = auth.mint_workload_token(
            subject=args.subject,
            audience=args.audience,
            ttl_seconds=getattr(args, "ttl", 900)
        )
        print(f"🔑 Minted OIDC Workload Identity Token:")
        print(f"   Subject: {args.subject}")
        print(f"   Audience: {args.audience}")
        print(f"   JWT: {tok}")
    elif action == "exchange":
        res = auth.exchange_cloud_credentials(
            token=args.token,
            provider=args.provider,
            role_arn_or_pool=args.role
        )
        print(f"✅ Cloud Workload Identity Federation Succeeded [{res.provider}]:")
        print(f"   Target Role: {res.target_role}")
        print(f"   Access Token ID: {res.access_token_id}")
        print(f"   Token Type: {res.token_type} | Expires: {res.expiration}")
    elif action == "audit":
        records = auth.get_exchange_audit_trail()
        print(f"📋 OIDC Credential Federation Audit Trail ({len(records)} events):")
        for r in records:
            print(f"   • [{r['timestamp']}] {r['provider']} -> {r['target_role']} (actor: {r['actor']}) status: {r['status']}")

def cmd_test(args):
    # Check if test sharding is requested
    total_shards = getattr(args, "total_shards", 1)
    shard_index = getattr(args, "shard_index", 0)
    if total_shards > 1:
        _require_engine(DistributedTestRunner, "distributed_test_runner", "test shard", "Free / Team / Business / Enterprise")
        runner = DistributedTestRunner(workspace_root=REPO_ROOT)
        all_tests = runner.discover_tests()
        shard_receipt = runner.run_shard(shard_index=shard_index, total_shards=total_shards, tests=all_tests)
        print(f"⚡ Distributed Test Shard [{shard_index + 1}/{total_shards}] Complete:")
        print(f"   Tests in shard: {len(shard_receipt.test_files)}")
        print(f"   Status: {shard_receipt.status} ({shard_receipt.passed_count} passed, {shard_receipt.failed_count} failed)")
        print(f"   Duration: {shard_receipt.duration_ms}ms")
        print(f"   Shard Hash: {shard_receipt.shard_hash[:16]}...")
        sys.exit(0 if shard_receipt.failed_count == 0 else 1)
    test_runner_dir = REPO_ROOT / ".nb" / "plan" / "test"
    if str(test_runner_dir) not in sys.path:
        sys.path.insert(0, str(test_runner_dir))
    try:
        from test_runner import PercipienceTestOrchestrator, DEFAULT_OUTPUT_DIR
    except ImportError as e:
        print(f"❌ Failed to load test orchestrator: {e}")
        sys.exit(1)

    out_dir = Path(args.output_dir) if getattr(args, "output_dir", None) else DEFAULT_OUTPUT_DIR
    orchestrator = PercipienceTestOrchestrator(
        tier=getattr(args, "tier", "all"),
        output_dir=out_dir,
        eval_ai=getattr(args, "eval_ai", True),
        ai_triage=getattr(args, "ai_triage", False),
        coverage=getattr(args, "coverage", False)
    )
    results = orchestrator.run_tests(quiet=getattr(args, "quiet", False))
    sys.exit(results.get("exit_code", 0))

