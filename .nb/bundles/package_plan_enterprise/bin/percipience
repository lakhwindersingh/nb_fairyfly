# Add .nb, .nb/core, workplace, and local bundle directories to sys.path
current_p = Path(__file__).resolve()
candidate_roots = [current_p.parents[1]]
if len(current_p.parents) > 2:
    candidate_roots.append(current_p.parents[2])

search_dirs = []
for r in candidate_roots:
    search_dirs.extend([
        r,
        r / ".nb",
        r / ".nb" / "core",
        r / "core",
        r / "workplace",
        r / "workplace" / "core",
    ])

for path_dir in search_dirs:
    if path_dir.exists() and str(path_dir) not in sys.path:
        sys.path.insert(0, str(path_dir))

# Dynamic discovery of user/system site-packages for dependencies (PyYAML, etc.)
try:
    import yaml
except ImportError:
    import glob
    candidate_sites = glob.glob(os.path.expanduser('~/Library/Python/*/lib/python/site-packages')) +                       glob.glob('/Library/Frameworks/Python.framework/Versions/*/lib/python*/site-packages') +                       glob.glob('/opt/homebrew/lib/python*/site-packages') +                       glob.glob('/usr/local/lib/python*/site-packages')
    for site in candidate_sites:
        if site not in sys.path and os.path.isdir(site):
            sys.path.append(site)

if current_p.parents[1].name in (".nb", "workplace") and len(current_p.parents) > 2:
    REPO_ROOT = current_p.parents[2]
else:
    REPO_ROOT = current_p.parents[1]

# Dynamic, plan-aware core engine loader
try:
    from core.config_manager import config
except (ImportError, ModuleNotFoundError):
    config = None

AVAILABLE_ENGINES = {}

def _load_engine(module_name: str, class_names: list):
    """
    Safely imports engine classes from core.<module_name> subject to availability
    in the active commercial plan bundle (Free, Team, Business, Enterprise).
    """
    try:
        mod = __import__(f"core.{module_name}", fromlist=class_names)
        results = [getattr(mod, cls, None) for cls in class_names]
        AVAILABLE_ENGINES[module_name] = True
        return results[0] if len(class_names) == 1 else results
    except (ImportError, ModuleNotFoundError):
        AVAILABLE_ENGINES[module_name] = False
        return None if len(class_names) == 1 else [None] * len(class_names)


def _require_engine(engine_obj, module_name: str, feature_desc: str, min_tier: str = "Team / Business / Enterprise") -> None:
    """Enforces that an engine is available in the current plan bundle before executing a command."""
    if engine_obj is None:
        print(f"⚠️  Feature '{feature_desc}' is unavailable in this plan bundle.")
        print(f"   Required engine module 'core/{module_name}.py' was not provisioned for the active tier.")
        print(f"   Please upgrade to a {min_tier} plan to unlock this capability.")
        sys.exit(1)


