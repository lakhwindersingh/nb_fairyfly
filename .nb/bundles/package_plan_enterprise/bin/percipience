    p_hitl = subparsers.add_parser("hitl", help="Interactive Human-In-The-Loop milestone checkpoints")
    p_hitl_subs = p_hitl.add_subparsers(dest="hitl_action", required=True)
    p_h_list = p_hitl_subs.add_parser("list", help="List milestone checkpoints")
    p_h_list.add_argument("--pending-only", action="store_true", help="Filter pending checkpoints")
