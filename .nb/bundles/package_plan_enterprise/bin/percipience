        print(f"✅ Autonomous CI/CD Pipeline Run Complete: {res['run_id']} (Sealed Merkle Block: {res['stages']['merkle_seal']['block_id']})")
    elif action == "heal":
        print(f"🩹 Triggering Autonomous Self-Healing on module: {args.target_module}...")
