        res = SelfImprovingEngine.analyze_and_optimize(REPO_ROOT)
        print(f"   Current Reduction: {res['current_avg_reduction_pct']:.1f}%")
        print("✅ Self-improving ledger updated: context/ledger/self_improving_ledger.yaml")

def cmd_layer(args):
    action = args.layer_action
    if action == "pack":
        if not check_basic_tools_permission():
            print("❌ Access Denied: Basic platform tools exposure and user plan packaging/encryption (.nbpack) are disabled on Free Community Tier.")
            print("   Free tier user plans remain strictly plaintext (non-encryptable).")
            print("   Use plaintext plans directly with '.nb/bin/percipience layer apply --plan <path>'.")
            sys.exit(1)
        plan_path = Path(args.plan)
        if not plan_path.is_absolute():
            plan_path = REPO_ROOT / plan_path
        if not plan_path.exists():
            print(f"❌ Plan file not found: {plan_path}")
            sys.exit(1)
        out_path = Path(args.output) if args.output else (REPO_ROOT / ".nb" / "bundles" / f"{plan_path.stem}.nbpack")
        if not out_path.is_absolute():
            out_path = REPO_ROOT / out_path
        spaces = [s.strip() for s in args.include_spaces.split(",")] if args.include_spaces else None
        print(f"📦 Compiling encrypted .nbpack layer from: {plan_path.name}")
        res = NBPackEnvelope.compile_layer_pack(REPO_ROOT, plan_path, out_path, include_spaces=spaces)
        print(f"✅ Sealed domain layer bundle created at: {res}")
        print(f"   Bundle Size: {res.stat().st_size} bytes")

    elif action == "apply":
        if args.pack:
            pack_path = Path(args.pack)
            if not pack_path.is_absolute():
                pack_path = REPO_ROOT / pack_path
            if not pack_path.exists():
                print(f"❌ Layer pack not found: {pack_path}")
                sys.exit(1)
            in_memory = not args.write_disk
            print(f"⚡ Consuming encrypted .nbpack domain layer: {pack_path.name}")
            res = NBPackEnvelope.apply_layer_pack(REPO_ROOT, pack_path, in_memory=in_memory)
            print(f"✅ Layer '{res['layer_id']}' applied successfully!")
            print(f"   Mode: {res['storage_mode']}")
            print(f"   Components Mounted: {res['components_loaded']}")
            print(f"   Merkle Block Sealed: {res['merkle_block_id']} ({res['merkle_block_hash'][:16]}...)")
        elif args.plan:
            plan_path = Path(args.plan)
            if not plan_path.is_absolute():
                plan_path = REPO_ROOT / plan_path
            if not plan_path.exists():
                print(f"❌ Plan file not found: {plan_path}")
                sys.exit(1)
            print(f"⚡ Applying plaintext domain layer: {plan_path.name}")
            block = MerkleEngine.seal_block(REPO_ROOT, action=f"LAYER_APPLIED:{plan_path.stem}")
            print(f"✅ Layer '{plan_path.stem}' applied successfully!")
            print(f"   Merkle Block Sealed: {block['block_id']}")

    elif action == "wrap":
        wrapped = TerminalAgentASTProxy.wrap_terminal_agent(
            agent_cmd=args.agent,
            agent_args=[],
            workspace_root=REPO_ROOT,
            format_type=getattr(args, "format", None)
        )
        print(f"✅ Terminal agent '{args.agent}' wrapped with AST compression:")
        print(f"   Session ID: {wrapped['session_id']}")
        print(f"   Context File: {wrapped['context_file']}")
        print(f"   Tokens Saved: {wrapped['tokens_saved']:,} ({wrapped['reduction_pct']}% savings)")
        print(f"   Injected Env: {list(wrapped['env'].keys())}")

    elif action == "list":
        ledger_path = (REPO_ROOT / ".nb" / "context" / "ledger" / "context_ledger.yaml" if (REPO_ROOT / ".nb" / "context").exists() else REPO_ROOT / "context" / "ledger" / "context_ledger.yaml")
        applied = []
        if ledger_path.exists():
            try:
                import yaml
                with open(ledger_path, "r", encoding="utf-8") as f:
                    data = yaml.safe_load(f) or {}
                    applied = data.get("applied_layers", [])
            except Exception:
                pass
        mounted = NBPackEnvelope.list_mounted_layers()
        print(f"📋 Registered Domain Layers ({len(applied)} recorded in ledger, {len(mounted)} mounted in RAM):")
        for layer in applied:
            print(f"   • {layer.get('layer_id')} [{layer.get('storage_mode')}] - SHA: {layer.get('bundle_sha256', '')[:12]}...")

    elif action in ("remove", "rollback"):
        layer_id = getattr(args, "layer", "") or getattr(args, "pack", "")
        if not layer_id:
            print("❌ Layer ID or pack path required for removal.")
            sys.exit(1)
        print(f"🔄 Rolling back setup for layer: {layer_id}...")
        res = NBPackEnvelope.remove_layer_pack(REPO_ROOT, layer_id)
        print(f"✅ Layer '{res['layer_id']}' rolled back with zero disk residue.")
        print(f"   Evicted from RAM: {res['evicted_from_ram']}")
        print(f"   Removed from Ledger: {res['removed_from_ledger']}")
        if res.get('merkle_block_id'):
            print(f"   Merkle Block Sealed: {res['merkle_block_id']}")


def cmd_drift(args):
    _require_engine(SemanticParityEngine, "semantic_parity_engine", "drift", "Team / Business / Enterprise")
    action = args.drift_action
    if action == "check":
        print("🔍 Evaluating 6-Vector Semantic Parity & Workspace Drift...")
        rep = SemanticParityEngine.compute_parity_report(REPO_ROOT)
        print(f"   Composite S_SP Score: {rep['composite_s_sp']:.4f} ({rep['classification']})")
        print(f"   Status Color: {rep['color']}")
        print(f"   Action: {rep['action_required']}")
        if rep['composite_s_sp'] >= 0.95:
            print("✅ Parity verified. Workspace is zero-drift and PR-merge ready.")
        elif rep['composite_s_sp'] >= 0.85:
            print("⚠️ Parity score in amber zone. Dual-reconciliation loop recommended.")
        else:
            print("⛔ Critical drift detected! Immediate rollback required.")
            sys.exit(1)

    elif action == "report":
        print("📊 Comprehensive 6-Vector Semantic Parity Breakdown:")
        rep = SemanticParityEngine.compute_parity_report(REPO_ROOT)
        print(f"   Composite S_SP: {rep['composite_s_sp']:.4f} [{rep['classification']}]")
        print("   --------------------------------------------------------")
        for vec, data in rep["vector_scores"].items():
            print(f"   • {vec.replace('_', ' ').title():<22}: Score = {data['score']:.2f} (Weight = {data['weight']:.2f})")
        print("   --------------------------------------------------------")
        print(f"   Action: {rep['action_required']}")

    elif action == "reconcile":
        mode = args.mode
        module_id = args.module or "mod_portal_marketing"
        if mode == "revert":
            symbols = [s.strip() for s in (args.symbols or "unprompted_helper,dead_abstract_fn").split(",")]
            print(f"🔄 Executing Automated Revert Mode on '{module_id}' for symbols: {symbols}...")
            res = DualReconciliationEngine.reconcile_revert(REPO_ROOT, module_id, symbols)
            print(f"✅ Revert diff synthesized in {res['execution_time_ms']}ms with {res['sibling_impact_pct']}% sibling impact.")
            print("--- Unified Reverse Diff ---")
            print(res["reverse_diff"])
        elif mode == "evolve":
            title = args.title or "Additive API Contract Evolution"
            desc = args.desc or "Subagent discovered necessary schema extension for rate-limiting."
            print(f"📝 Drafting RFC Specification Delta in user/hitl/proposed_spec_delta.md...")
            res = DualReconciliationEngine.reconcile_evolve(
                workspace_root=REPO_ROOT,
                module_id=module_id,
                title=title,
                description=desc,
                proposed_fields=[{"name": "rate_limit_rpm", "type": "integer", "description": "Requests per minute"}]
            )
            print(f"✅ Spec delta RFC '{res['delta_id']}' drafted successfully at {res['file_path']}.")
            print(f"   Awaiting Human-in-the-Loop review and approval.")

    elif action == "approve-delta":
        delta_id = args.delta_id or "DELTA_LATEST"
        print(f"✍️ Approving RFC Specification Delta: {delta_id}...")
        res = DualReconciliationEngine.approve_delta(REPO_ROOT, delta_id)
        print(f"✅ {res['message']}")

def cmd_hitl(args):
    action = args.hitl_action
    from workplace.core.hitl_checkpoint_manager import HITLCheckpointManager
    mgr = HITLCheckpointManager(workspace_root=REPO_ROOT)
    if action == "list":
        chks = mgr.list_checkpoints(pending_only=args.pending_only)
        if not chks:
            print("ℹ️ No milestone checkpoints found.")
            return
        print(f"📋 Percipience HITL Milestone Checkpoints ({len(chks)} total):")
        for c in chks:
            badge = "⏳ PENDING" if c.status == "PENDING" else f"🏁 {c.status}"
            print(f"   • [{c.checkpoint_id}] {badge} | {c.milestone_type} | {c.title}")
    elif action == "approve":
        try:
            chk = mgr.resolve_checkpoint(args.id, decision="APPROVE", reason=args.comment or "Approved via CLI", resolver=args.resolver or "cli_operator")
            print(f"✅ Checkpoint {chk.checkpoint_id} APPROVED successfully.")
            print(f"   Resolution: {chk.resolution.reason}")
        except Exception as e:
            print(f"❌ Error approving checkpoint: {e}")
            sys.exit(1)
    elif action == "reject":
        try:
            chk = mgr.resolve_checkpoint(args.id, decision="REJECT", reason=args.reason or "Rejected via CLI", resolver=args.resolver or "cli_operator")
            print(f"🛑 Checkpoint {chk.checkpoint_id} REJECTED.")
            print(f"   Reason: {chk.resolution.reason}")
        except Exception as e:
            print(f"❌ Error rejecting checkpoint: {e}")
            sys.exit(1)


