def cmd_license(args):
    """Manages, mints, installs, and verifies commercial tier licenses."""
    action = getattr(args, "lic_action", "status")
    if action == "status":
        active = CommercialPackagerProvisioner.get_active_license(REPO_ROOT)
        print("📜 Percipience Active Commercial License:")
        print(f"   • License ID: {active.get('license_id')}")
        print(f"   • Tier: {active.get('tier_name', active.get('tier')).upper()} ({active.get('tier')})")
        print(f"   • Tenant ID: {active.get('tenant_id')}")
        print(f"   • Tenant Name: {active.get('tenant_name')}")
        seats = active.get("included_seats")
        wts = active.get("included_concurrent_worktrees")
        audits = active.get("included_pr_audits_monthly")
        print(f"   • Quotas: {('Unlimited' if seats == -1 else seats)} Seats | {('Unlimited' if wts == -1 else wts)} Worktrees | {('Unlimited' if audits == -1 else audits)} Audits/mo")
        if active.get("payment_reference"):
            print(f"   • Payment Reference: {active.get('payment_reference')}")
        print(f"   • Signature: {active.get('signature_sha256', 'N/A')}")
        inst_label = f"Yes ({active.get('source_path')})" if active.get("is_installed") else "No (Using unauthenticated default)"
        print(f"   • Installed: {inst_label}")
    elif action in ["mint", "generate"]:
        tier = getattr(args, "tier", "plan_team")
        tenant_id = getattr(args, "tenant", "tenant_custom")
        tenant_name = getattr(args, "name", None)
        seats = getattr(args, "seats", None)
        worktrees = getattr(args, "worktrees", None)
        audits = getattr(args, "audits", None)
        payment_ref = getattr(args, "payment_ref", None)
        out_file = getattr(args, "out", None)

        lic_data = CommercialPackagerProvisioner.generate_license(
            workspace_root=REPO_ROOT,
            tier=tier,
            tenant_id=tenant_id,
            tenant_name=tenant_name,
            seats=seats,
            worktrees=worktrees,
            audits=audits,
            payment_reference=payment_ref
        )
        if out_file:
            p = Path(out_file)
            p.parent.mkdir(parents=True, exist_ok=True)
            p.write_text(json.dumps(lic_data, indent=2), encoding="utf-8")
            print(f"✓ License minted and saved to {p}")
        else:
            print(json.dumps(lic_data, indent=2))
        if getattr(args, "install", False):
            inst = CommercialPackagerProvisioner.install_license(REPO_ROOT, lic_data)
            print(f"✓ Installed into active workspace: {inst['installed_path']}")
    elif action == "install":
        file_path = getattr(args, "file", None)
        if file_path:
            p = Path(file_path)
            if not p.exists():
                print(f"❌ File not found: {p}")
                sys.exit(1)
            lic_data = json.loads(p.read_text(encoding="utf-8"))
        else:
            tier = getattr(args, "tier", "plan_team")
            tenant_id = getattr(args, "tenant", "tenant_custom")
            lic_data = CommercialPackagerProvisioner.generate_license(
                workspace_root=REPO_ROOT,
                tier=tier,
                tenant_id=tenant_id
            )
        inst = CommercialPackagerProvisioner.install_license(REPO_ROOT, lic_data)
        print(f"✓ Successfully installed license {inst['license_id']} ({inst['tier']}) into {inst['installed_path']}")


def cmd_status(args):
    """Reports active plan tier, loaded core engines, and unavailable features."""
    active = CommercialPackagerProvisioner.get_active_license(REPO_ROOT)
    active_plan = active.get("tier", "plan_free")
    if "PERCIPIENCE_PLAN" in os.environ:
        active_plan = os.environ["PERCIPIENCE_PLAN"]

    loaded = [k for k, v in AVAILABLE_ENGINES.items() if v]
    missing = [k for k, v in AVAILABLE_ENGINES.items() if not v]

    print(f"📊 Percipience Runtime Status:")
    print(f"   • Active Plan Tier: {active_plan.upper()}")
    print(f"   • Core Engines Available: {len(loaded)} / {len(AVAILABLE_ENGINES)}")
    print(f"   • Provisioned Engines:")
    for eng in sorted(loaded):
        print(f"     ✅ core/{eng}.py")
    if missing:
        print(f"   • Unavailable In Current Plan ({len(missing)}):")
        for eng in sorted(missing):
            print(f"     🔒 core/{eng}.py (Requires plan upgrade)")
    print(f"   • Merkle Continuous: {MerkleEngine is not None}")

def cmd_package(args):
    _require_engine(CommercialPackagerProvisioner, "commercial_packager_provisioner", "package", "Enterprise")
    tier = getattr(args, "tier", "free")
    out_dir = Path(args.output) if getattr(args, "output", None) else None
    tenant = getattr(args, "tenant", "tenant_community_default")
    print(f"📦 Packaging Percipience assets for tier: {tier} (Tenant: {tenant})...")
    res = CommercialPackagerProvisioner.package_tier(
        workspace_root=REPO_ROOT,
        tier=tier,
        output_dir=out_dir,
        tenant_id=tenant
    )
    print(f"✅ Packaging complete: {res['status']}")
    print(f"   Tier: {res['tier_name']} ({res['tier']})")
    print(f"   Target Bundle: {res['package_dir']}")
    print(f"   Total Assets Bundled: {res['total_files']}")
    print(f"   License SHA-256: {res['license_signature'][:16]}...")
    if res.get("merkle_block_id"):
        print(f"   Merkle Block Sealed: {res['merkle_block_id']}")

def cmd_provision(args):
    _require_engine(CommercialPackagerProvisioner, "commercial_packager_provisioner", "provision", "Enterprise")
    tenant = args.tenant
    tier = getattr(args, "tier", "free")
    target = getattr(args, "target", "all")
