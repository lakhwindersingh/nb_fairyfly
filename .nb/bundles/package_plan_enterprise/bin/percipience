def cmd_tokens(args):
    _require_engine(UnifiedTokenOptimizer, "token_optimizer_suite", "tokens", "Free / Team / Business / Enterprise")
    action = args.tokens_action
    if action == "status":
        cfg = TokenOptimizationConfig.load_config(REPO_ROOT).get("token_optimization", {})
        ledger = TokenTracker.load_ledger(REPO_ROOT)
        s = ledger.get("summary", {})
        print("⚡ Percipience Token Optimization & FinOps Status:")
        print(f"   Master Status: {'ENABLED' if cfg.get('enabled') else 'DISABLED'}")
        print(f"   Intensity Mode: {cfg.get('mode', 'standard')}")
        print("   Active Strategies:")
        for strat, val in cfg.get("strategies", {}).items():
            icon = "✓" if (val and cfg.get('enabled')) else "✗"
            print(f"     [{icon}] {strat}: {'ON' if val else 'OFF'}")
        print("\n📊 Cumulative Metering Summary:")
        print(f"   Total Events Tracked: {s.get('total_events', 0):,}")
        print(f"   Total Tokens Saved: {s.get('total_tokens_saved', 0):,} ({s.get('average_reduction_pct', 0.0):.1f}% avg reduction)")
        print(f"   Gross Spend Saved: ${s.get('total_gross_savings_usd', 0.0):.4f} USD")
        print(f"   15% Performance Fee: ${s.get('total_rev_share_fee_usd', 0.0):.4f} USD")
        print(f"   Net Customer Cash Saved: ${s.get('total_net_savings_usd', 0.0):.4f} USD")

    elif action == "enable":
        TokenOptimizationConfig.set_enabled(True, REPO_ROOT)
        print("✅ Token optimization enabled globally for workspace and CI/CD pipelines.")

    elif action == "disable":
        TokenOptimizationConfig.set_enabled(False, REPO_ROOT)
        print("⏸️  Token optimization disabled. All context payloads will pass through uncompressed.")

    elif action == "set-mode":
        TokenOptimizationConfig.set_mode(args.mode, REPO_ROOT)
        print(f"✅ Token optimization intensity preset updated to: '{args.mode}'.")

    elif action == "set-strategy":
        enabled = (args.state.lower() in ["on", "true", "1", "enable", "enabled"])
        TokenOptimizationConfig.set_strategy(args.strategy, enabled, REPO_ROOT)
        state_str = "ENABLED" if enabled else "DISABLED"
        print(f"✅ Strategy '{args.strategy}' is now {state_str}.")

    elif action == "optimize":
        file_path = Path(args.file)
        if not file_path.exists():
            print(f"❌ File not found: {args.file}")
            sys.exit(1)
        content = file_path.read_text(encoding="utf-8", errors="ignore")
        ext = file_path.suffix.lstrip(".")
        type_map = {"py": "python", "ts": "typescript", "js": "javascript", "go": "go", "rs": "rust", "md": "markdown", "yaml": "yaml", "yml": "yaml", "json": "json", "log": "log", "diff": "diff"}
        ctype = type_map.get(ext, "python")
        mode = getattr(args, "mode", None)
        pruned, stats = UnifiedTokenOptimizer.optimize_content(content, ctype, REPO_ROOT, override_mode=mode)
        print(f"⚡ Token Optimization Results for: {file_path.name} ({ctype}):")
        print(f"   Status: {stats.get('status', 'OPTIMIZED')}")
        print(f"   Baseline Tokens: {stats.get('uncompressed_tokens', 0):,}")
        print(f"   Pruned Tokens: {stats.get('pruned_tokens', 0):,}")
        print(f"   Net Tokens Saved: {stats.get('saved_tokens', 0):,} ({stats.get('reduction_pct', stats.get('reduction_percentage', 0.0))}% reduction)")

    elif action == "track":
        file_path = Path(args.file)
        if not file_path.exists():
            print(f"❌ File not found: {args.file}")
            sys.exit(1)
        content = file_path.read_text(encoding="utf-8", errors="ignore")
        ext = file_path.suffix.lstrip(".")
        lang = "typescript" if ext in ["ts", "js"] else ("python" if ext == "py" else ext)
        _, stats = ASTOptimizer.prune_source(content, lang)
        try:
            rel_path = str(file_path.resolve().relative_to(REPO_ROOT.resolve()))
        except Exception:
            rel_path = str(file_path)
        evt = TokenTracker.record_event(
            repo_root=REPO_ROOT,
            file_path=rel_path,
            uncompressed_tokens=stats["uncompressed_tokens"],
            pruned_tokens=stats["pruned_tokens"],
            session_or_pr=args.pr or "manual_cli",
            model_id=args.model or "claude-3-5-sonnet-20241022"
        )
        print(f"✅ Token savings captured for: {rel_path}")
        print(f"   Uncompressed: {evt['uncompressed_tokens']:,} tokens | Pruned: {evt['pruned_tokens']:,} tokens")
        print(f"   Saved: {evt['tokens_saved']:,} tokens ({evt['reduction_percentage']}%)")
        print(f"   Gross Savings: ${evt['gross_savings_usd']:.5f} | Net Client Savings: ${evt['net_savings_usd']:.5f}")

    elif action == "scan":
        target = args.dir if args.dir else "workplace"
        print(f"⚡ Scanning repository directory '{target}' for AST token compression...")
        res = TokenTracker.scan_and_track_repo(
            repo_root=REPO_ROOT,
            target_dir=target,
            session_or_pr=args.pr or "ci_scan",
            model_id=args.model or "claude-3-5-sonnet-20241022"
        )
        s = res["summary"]
        print(f"✅ AST Pruning Scan Complete: {res['new_events_count']} files logged to ledger.")
        print(f"   Total Uncompressed: {s.get('total_uncompressed_tokens', 0):,} tokens")
        print(f"   Total Pruned: {s.get('total_pruned_tokens', 0):,} tokens")
        print(f"   Total Tokens Saved: {s.get('total_tokens_saved', 0):,} tokens ({s.get('average_reduction_pct', 0.0):.1f}% reduction)")
        print(f"   Gross Dollar Savings: ${s.get('total_gross_savings_usd', 0.0):.4f}")
        print(f"   15% Performance Fee: ${s.get('total_rev_share_fee_usd', 0.0):.4f}")
        print(f"   Net Client Savings: ${s.get('total_net_savings_usd', 0.0):.4f}")

    elif action == "summary":
        ledger = TokenTracker.load_ledger(REPO_ROOT)
        s = ledger.get("summary", {})
        print("📊 Percipience Token Savings & Metering Summary:")
        print(f"   Events Tracked: {s.get('total_events', 0):,}")
        print(f"   Total Tokens Saved: {s.get('total_tokens_saved', 0):,} tokens ({s.get('average_reduction_pct', 0.0):.1f}% avg reduction)")
        print(f"   Gross Financial Savings: ${s.get('total_gross_savings_usd', 0.0):.4f} USD")
        print(f"   15% Performance Fee: ${s.get('total_rev_share_fee_usd', 0.0):.4f} USD")
        print(f"   Net Customer Cash Saved: ${s.get('total_net_savings_usd', 0.0):.4f} USD")
        print(f"   Ledger: .nb/context/ledger/token_savings_ledger.yaml")

    elif action == "report":
        out_path = Path(args.output) if args.output else None
        TokenTracker.generate_markdown_report(REPO_ROOT)
        dest = out_path or (REPO_ROOT / "workplace/docs/reports/token_savings_report.md")
        print(f"✅ Token savings scorecard emitted to: {dest}")

