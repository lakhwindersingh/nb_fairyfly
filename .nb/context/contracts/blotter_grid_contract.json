{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BlotterGridContract",
  "type": "object",
  "required": [
    "positions",
    "total_count",
    "unrealized_total_pnl"
  ],
  "properties": {
    "total_count": {
      "type": "integer",
      "minimum": 0
    },
    "unrealized_total_pnl": {
      "type": "number"
    },
    "positions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "position_id",
          "symbol",
          "strategy_name",
          "net_delta",
          "net_gamma",
          "net_theta",
          "unrealized_pnl",
          "last_price",
          "status"
        ],
        "properties": {
          "position_id": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "strategy_name": {
            "type": "string"
          },
          "net_delta": {
            "type": "number"
          },
          "net_gamma": {
            "type": "number"
          },
          "net_theta": {
            "type": "number"
          },
          "net_vega": {
            "type": "number"
          },
          "unrealized_pnl": {
            "type": "number"
          },
          "realized_pnl": {
            "type": "number"
          },
          "margin_req": {
            "type": "number"
          },
          "last_price": {
            "type": "number"
          },
          "day_change_pct": {
            "type": "number"
          },
          "last_tick_timestamp": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "ADJUSTED",
              "ROLLED",
              "CLOSED"
            ]
          }
        }
      }
    }
  }
}