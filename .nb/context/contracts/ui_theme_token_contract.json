{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UIThemeTokenContract",
  "description": "W3C Design Token Schema validating enterprise themes, typography, 8px spatial grid, and financial colors.",
  "type": "object",
  "required": [
    "version",
    "themes",
    "spatial_grid",
    "control_heights",
    "typography"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "spatial_grid": {
      "type": "object",
      "required": [
        "base_unit_px",
        "scale"
      ],
      "properties": {
        "base_unit_px": {
          "type": "integer",
          "enum": [
            8
          ]
        },
        "scale": {
          "type": "object",
          "required": [
            "space-0-5",
            "space-1",
            "space-2",
            "space-3",
            "space-4",
            "space-6",
            "space-8"
          ],
          "properties": {
            "space-0-5": {
              "type": "string",
              "pattern": "^4px$"
            },
            "space-1": {
              "type": "string",
              "pattern": "^8px$"
            },
            "space-1-5": {
              "type": "string",
              "pattern": "^12px$"
            },
            "space-2": {
              "type": "string",
              "pattern": "^16px$"
            },
            "space-3": {
              "type": "string",
              "pattern": "^24px$"
            },
            "space-4": {
              "type": "string",
              "pattern": "^32px$"
            },
            "space-6": {
              "type": "string",
              "pattern": "^48px$"
            },
            "space-8": {
              "type": "string",
              "pattern": "^64px$"
            }
          }
        }
      }
    },
    "control_heights": {
      "type": "object",
      "required": [
        "control-height-xs",
        "control-height-sm",
        "control-height-md",
        "control-height-lg",
        "control-height-xl"
      ],
      "properties": {
        "control-height-xs": {
          "type": "string",
          "pattern": "^24px$"
        },
        "control-height-sm": {
          "type": "string",
          "pattern": "^32px$"
        },
        "control-height-md": {
          "type": "string",
          "pattern": "^40px$"
        },
        "control-height-lg": {
          "type": "string",
          "pattern": "^48px$"
        },
        "control-height-xl": {
          "type": "string",
          "pattern": "^56px$"
        }
      }
    },
    "typography": {
      "type": "object",
      "required": [
        "font_sans",
        "font_heading",
        "font_mono",
        "tabular_numerics"
      ],
      "properties": {
        "font_sans": {
          "type": "string"
        },
        "font_heading": {
          "type": "string"
        },
        "font_mono": {
          "type": "string"
        },
        "tabular_numerics": {
          "type": "boolean",
          "enum": [
            true
          ]
        }
      }
    },
    "themes": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "bg_app",
          "surface_card",
          "text_primary",
          "color_finance_gain",
          "color_finance_loss"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "corporate-light",
              "enterprise-dark",
              "pro-oled"
            ]
          },
          "name": {
            "type": "string"
          },
          "bg_app": {
            "type": "string"
          },
          "surface_card": {
            "type": "string"
          },
          "text_primary": {
            "type": "string"
          },
          "color_finance_gain": {
            "type": "string"
          },
          "color_finance_loss": {
            "type": "string"
          }
        }
      }
    }
  }
}