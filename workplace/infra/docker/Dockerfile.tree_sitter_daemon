# =============================================================================
# Percipience Standalone Native Tree-Sitter AST Daemon Container
# =============================================================================
FROM python:3.14-slim

WORKDIR /workspace

# Install minimal build tools and curl for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    build-essential \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY workplace/infra/docker/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# Copy required engine and source spaces
COPY .nb /workspace/.nb
COPY workplace /workspace/workplace

ENV PYTHONPATH=/workspace/workplace:/workspace/.nb:/workspace
ENV PERCIPIENCE_DAEMON_HOST=0.0.0.0
ENV PERCIPIENCE_DAEMON_PORT=8585

EXPOSE 8585

HEALTHCHECK --interval=5s --timeout=3s --retries=5 \
  CMD curl -f http://127.0.0.1:8585/health || exit 1

ENTRYPOINT ["python3", "-m", "workplace.core.tree_sitter_daemon"]
